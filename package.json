{
    "name": "@cybearl/cypack",
    "version": "0.0.0-semantically-released",
    "description": "A set of general utilities for Cybearl projects.",
    "author": "Cybearl <contact@cybearl.com> (https://www.cybearl.com/)",
    "license": "MIT",
    "private": false,
    "packageManager": "npm@11.4.2",
    "type": "module",
    "keywords": [
        "cybearl",
        "cypack",
        "utilities"
    ],
    "homepage": "https://github.com/cybearl/cypack",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cybearl/cypack.git"
    },
    "bugs": {
        "url": "https://github.com/cybearl/cypack/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public",
        "tag": "latest"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "files": [
        "*"
    ],
    "main": "./index.js",
    "module": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        "./backend": {
            "types": "./backend.d.ts",
            "node": "./backend.js",
            "default": "./backend.js"
        },
        "./frontend": {
            "types": "./frontend.d.ts",
            "import": "./frontend.js",
            "default": "./frontend.js"
        },
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        }
    },
    "scripts": {
        "knip": "knip",
        "lint": "biome check && npm run lint:nitpicker",
        "lint:fix": "npm run lint:nitpicker:fix && biome check --fix && biome format --write",
        "lint:nitpicker": "eslint \"{src,tests}/**/*.ts\"",
        "lint:nitpicker:fix": "eslint \"{src,tests}/**/*.ts\" --fix",
        "test:sandbox": "tsx ./tests/sandbox.ts",
        "test:bench": "tsx ./tests/benchmark.ts",
        "test:unit": "vitest",
        "test": "npm run test:unit",
        "build": "tsup",
        "release": "npx semantic-release",
        "hooks:install": "node -e \"if(require('fs').existsSync('.git'))require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'inherit'})\"",
        "prepare": "npm run hooks:install"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "colorette": "^2.0.20",
        "dateformat": "^5.0.3",
        "dedent-js": "^1.0.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "slugify": "^1.6.9",
        "tailwind-merge": "^3.7.0"
    },
    "peerDependencies": {
        "next": "^15.5.15 || ^16.0.0",
        "react": "^19.1.1",
        "react-dom": "^19.2.5",
        "typescript": ">=5.8.3"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    },
    "devDependencies": {
        "@alien_intelligence/eslint-plugin-nitpicker": "^0.11.0",
        "@biomejs/biome": "^2.5.14",
        "@types/copyfiles": "^2.4.4",
        "@types/dateformat": "^5.0.3",
        "@types/minimist": "^1.2.5",
        "@types/node": "^24.13.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/parser": "^8.70.1",
        "copyfiles": "^2.4.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^10.11.0",
        "knip": "^6.38.0",
        "minimist": "^1.2.8",
        "next": "16.3.6",
        "next-auth": "^4.24.15",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "semantic-release": "^25.0.9",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^8.3.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.63.4",
        "@rollup/rollup-win32-x64-msvc": "^4.63.4"
    },
    "overrides": {
        "@types/react": "$@types/react",
        "@types/react-dom": "$@types/react-dom",
        "tsup": {
            "esbuild": "^0.28.2"
        }
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
